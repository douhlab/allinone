{
  "name": "allinone",
  "version": "1.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prestart": "npm run setup-git-hooks",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test-coverage": "jest --coverage=true",
    "build-prod": "node --max_old_space_size=6144 ./node_modules/@angular/cli/bin/ng build --configuration production --output-hashing=all",
    "sonar": "sonar-scanner",
    "setup-git-hooks": "cp -n tools/git-hooks/* .git/hooks/ || :",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "e2e-headless": "ng run allinone:cypress-run",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/material": "^17.3.10",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-builders/jest": "^17.0.3",
    "@angular-devkit/build-angular": "^17.3.2",
    "@angular-eslint/builder": "17.3.0",
    "@angular-eslint/eslint-plugin": "17.3.0",
    "@angular-eslint/eslint-plugin-template": "17.3.0",
    "@angular-eslint/schematics": "17.3.0",
    "@angular-eslint/template-parser": "17.3.0",
    "@angular/cli": "^17.3.2",
    "@angular/compiler-cli": "^17.3.0",
    "@cypress/schematic": "^2.5.1",
    "@testing-library/angular": "^15.2.0",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "@typescript-eslint/parser": "7.2.0",
    "cypress": "^13.7.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-esm-transformer": "^1.0.0",
    "jest-preset-angular": "^13.1.6",
    "prettier": "^3.2.5",
    "prettier-eslint": "^16.3.0",
    "sonar-scanner": "^3.1.0",
    "ts-jest": "^29.1.0",
    "typescript": "~5.4.2"
  }
}
