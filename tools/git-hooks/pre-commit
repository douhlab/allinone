#!/bin/sh

# 1. get the list of staged files, (ts, md or scss)
# 2. format the files with eslint and stylelint, so that it also outputs the warnings,
#    or with prettier in case of md files.

TS_FILES=$(git diff HEAD --name-only --staged --diff-filter=d | grep -E '\.ts$')

if [ -n "$TS_FILES" ]; then
   echo "Running pre-commit hook: formatting with eslint on the following files"
   echo $TS_FILES
   npx eslint --fix $TS_FILES
   echo "Adding the files again"
   git add $TS_FILES
fi

# Do the same for markdown files
MD_FILES=$(git diff HEAD --name-only --staged --diff-filter=d | grep -E '\.md$')

if [ -n "$MD_FILES" ]; then
   echo "Running pre-commit hook: formatting with prettier on the following files"
   echo $MD_FILES
   npx prettier -w $MD_FILES
   echo "Adding the files again"
   git add $MD_FILES
fi
